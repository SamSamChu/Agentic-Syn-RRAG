+class RotatingTemplateDataset(Dataset):
+    """
+    df must contain: 'molecule_hash', 'template_id', 'system_prompt_id', 'question', 'answer'
+    Each molecule can have multiple rows (different templates). We pick one row per molecule per epoch.
+    """
+    def __init__(self, df):
+        self.df = df.copy()
+        # group index list per molecule_hash
+        self.groups = self.df.groupby("indice").indices  # dict: hash -> array of indices
+
+    def sample_for_epoch(self, epoch):
+        picks = []
+        for mol_hash, idxs in self.groups.items():
+            # rotate index choice by epoch
+            pick_idx = idxs[epoch % len(idxs)]
+            picks.append(pick_idx)
+        self.epoch_df = self.df.loc[picks].reset_index(drop=True)
+
+    def __len__(self):
+        return len(self.epoch_df)
+
+    def __getitem__(self, idx):
+        row = self.epoch_df.iloc[idx]
+        #'indice','Products', 'Reactants', 'instruction', 'output', 'instruct_id'
+        return {
+            "indice": row["indice"],
+            "instruction": row["instruction"],
+            "output": row["output"],
+            "instruct_id": row["instruct_id"],
+            "Products": row["Products"],
+            "Reactants": row["Reactants"]
+        }
diff --git a/src/llamafactory/train/sft/sampler_utils.py b/src/llamafactory/train/sft/sampler_utils.py
new file mode 100644
index 00000000..22e97c53
--- /dev/null
+++ b/src/llamafactory/train/sft/sampler_utils.py
@@ -0,0 +1,48 @@
+import torch
+from torch.utils.data import Sampler
+import random
+
+class SpecificIndexSampler(Sampler):
+    """
+    A sampler that returns indices based on a specific value in a dataset column for each epoch.
+    """
+    def __init__(self, data_source, index_column='indice', num_epochs=4):
+        self.data_source = data_source
+        self.index_column = index_column
+        self.num_epochs = num_epochs
+        self.current_epoch = 0
+        
+        # Pre-compute a mapping from index value to row indices for efficiency.
+        # This prevents repeated searching through the dataset in each epoch.
+        self.indices_map = {idx_val: [] for idx_val in range(1, num_epochs + 1)}
+        print(f"====DEBUG INFO, {data_source[0].keys()}")
+        if "indice" in data_source[0].keys():
+            for i, item in enumerate(data_source):
+                idx_val = item[index_column]
+                if idx_val in self.indices_map:
+                    self.indices_map[idx_val].append(i)
+        else:
+            for idx_val in range(1, num_epochs + 1):
+                self.indices_map[idx_val] = [i for i in range(len(data_source))]
+    
+    def __iter__(self):
+        # Determine the target index value based on the current epoch.
+        # For epoch 1, target is 1; for epoch 2, target is 2, etc.
+        target_idx_val = self.current_epoch + 1
+        
+        if target_idx_val in self.indices_map:
+            indices = self.indices_map[target_idx_val].copy() # Get the list of indices
+            #print("===DEBUG SHAN: ", indices)
+            random.shuffle(indices) # Shuffle the list in-place
+            return iter(indices)
+            #return iter(self.indices_map[target_idx_val])
+        else:
+            return iter([]) # Return an empty iterator if no matching rows are found.
+    
+    def __len__(self):
+        target_idx_val = self.current_epoch + 1
+        return len(self.indices_map.get(target_idx_val, []))
+    
+    def set_epoch(self, epoch):
+        """Allows the Trainer to communicate the current epoch to the sampler."""
+        self.current_epoch = epoch
