+import os
+import json
+from accelerate import Accelerator
+from transformers import AutoModelForCausalLM, AutoTokenizer
+from datasets import load_dataset
+import torch
+import tqdm
+import re
+import json
+from collections import defaultdict
+from rdkit import Chem
+
+#tqdm(range(100), desc="Processing items")
+
+accelerator = Accelerator()
+device = accelerator.device
+
+def cot_with_clear_format(smiles):
+    return f"""
+As professor in organic chemistry, identify reactants. Target molecule: {smiles}
+
+Please reason step by step, then provide the final answer after "FINAL ANSWER:".
+
+Reasoning steps:
+1. Analyze functional groups
+2. Identify possible disconnections
+3. Suggest starting materials
+
+After your reasoning, provide the final answer in this exact format:
+FINAL ANSWER: [SMILES here]
+
+Reasoning:
+"""
+
+def main(model_id, dataset_file_path, num_sample=5, output_path="predictions.jsonl", batch_size=4, max_new_tokens=128):
+    # -------------------------------------------------
+    # Setup accelerator (handles multi-GPU distribution)
+    # -------------------------------------------------
+
+    # -------------------------------------------------
+    # Load model + tokenizer
+    # -------------------------------------------------
+    tokenizer = AutoTokenizer.from_pretrained(model_id)
+    tokenizer.padding_side = "left"
+    model = AutoModelForCausalLM.from_pretrained(
+        model_id,
+        dtype=torch.bfloat16,
+        device_map={"": device},  # Accelerate maps to local device
+    )
+
+    # -------------------------------------------------
+    # Load dataset
+    #   assume dataset has fields: "question", "answer"
+    # -------------------------------------------------
+    dataset = load_dataset("json", data_files=dataset_file_path, split="train")
+
+    
+    #indices_to_keep = range(0, len(dataset), 41)
+    #filtered_dataset = dataset.select(indices_to_keep)
+    filtered_dataset = dataset
+    # Shard dataset across processes
+    dataset = filtered_dataset.shard(num_shards=accelerator.num_processes, index=accelerator.process_index)
+
+    # -------------------------------------------------
+    # Batched inference
+    # -------------------------------------------------
+    results = []
+    for i in tqdm.tqdm(range(0, len(dataset), batch_size), desc="Processing inference generation items"):
+        batch = dataset[i: i + batch_size]
+        questions = batch["instruction"]
+        #systems_prompt = batch["system"]
+        answer = batch["output"]
+        types = batch["Task type"]
+        messages = []
+        bs = len(questions)
+        for j in range(bs):
+            native = [{"role":"user", "content": questions[j]}]
+            #cot = [{"role":"user", "content":cot_with_clear_format(batch["Products"][j])}]
+            #cot_g = True
+            #messages.append(questions[j][:2])
+            messages.append(native)
+        # apply chat template
+        print(messages)
+        #assert 0
+        text = tokenizer.apply_chat_template(
+            messages,
+            tokenize = False,
+            add_generation_prompt = True, # Must add for generation
+            enable_thinking=False,
+        )#.to(device)
+        inputs = tokenizer(text, padding=True,truncation=True,return_tensors = "pt").to(device)
+        seq_len = len(inputs["input_ids"][0])
+
+        # Tokenize (right padding for batching)
+        '''
+        inputs = tokenizer(
+            questions,
+            return_tensors="pt",
+            padding=True,
+            truncation=True,
+        ).to(device)
+        #batch, seq_len = inputs.size()
+        seq_len = len(inputs["input_ids"][0])'''
+        #introduce topk sampling
+        #TODO, update this key to argparse
+        num_samples = num_sample
+        with torch.no_grad():
+            outputs = model.generate(
+                **inputs,
+                do_sample = False, #for top1 do_sample setting False, otherwise to be True, for multiple returns #num_return_sequences=num_samples, # top_5 generations
+                num_return_sequences=num_samples,
+                use_cache=True,
+                temperature = 0.0, #top_p = 0.8, top_k = 20, #temperature 0.0 or temperature 0.3 for top1
+                #with beam search
+                num_beams=num_samples,
+                max_new_tokens=max_new_tokens,
+                pad_token_id=tokenizer.pad_token_id,
+                eos_token_id=tokenizer.eos_token_id,
+            )
+
+        decoded = tokenizer.batch_decode(outputs[:, seq_len:], skip_special_tokens=True)
+        #print(f"===curent decoded is {decoded!r} ")
+        #assert 0
+
+        for index, (ans, q, type_t) in enumerate(zip(answer, questions, types)):
+            preds = decoded[index*num_samples:(index+1)*num_samples]
+            #Change to save SMILE Directly
+            results.append({
+                "Task type": type_t,
+                "question": q,
+                "gold_answer": ans,
+                "predicted_answer": preds,
+            })
+
+    # -------------------------------------------------
+    # Save per-rank results
+    # -------------------------------------------------
+    local_out = output_path
+    with open(local_out, "w") as f:
+        for r in results:
+            f.write(json.dumps(r, ensure_ascii=False) + "\n")
+
+    accelerator.wait_for_everyone()
+    if accelerator.is_main_process:
+        print(f"[Main] Inference complete. Outputs written as {output_path}.rank*")
+
+def json_exact(element):
+    #pattern_1 =  r"\{.*?\}" #r'\{(.*?)]\}'
+    #match = re.search(pattern_1, element, re.DOTALL)
+    fixed_json_string = element.replace("'", '"')
+    #ogger.info(f"Current match filded or not {pred} and {match.group(0)}")
+    try:
+        pred_json = json.loads(fixed_json_string)
+    except Exception as e:
+        pred_json = {}
+        print(f"An unexpected error occurred with {element}: {e}")
+    return pred_json
+        
+def standardize_to_canonical(smiles_string):
+    """
+    Takes ANY valid SMILES string (mapped, zero-mapped, or random),
+    strips all mapping, and returns a strict, clean Canonical SMILES.
+    """
+    if not isinstance(smiles_string, str) or not smiles_string.strip():
+        return None
+
+    try:
+        mol = Chem.MolFromSmiles(smiles_string)
+        if mol is None:
+            return None # The LLM hallucinated invalid grammar
+            
+        # Aggressively clear any mapping properties 
+        # (even though RDKit usually treats :0 as unmapped, this guarantees it)
+        for atom in mol.GetAtoms():
+            if atom.HasProp('molAtomMapNumber'):
+                atom.ClearProp('molAtomMapNumber')
+                
+        # Generate the strict, unmapped canonical string
+        return Chem.MolToSmiles(mol, doRandom=False, canonical=True)
+        
+    except Exception:
+        return None
+
