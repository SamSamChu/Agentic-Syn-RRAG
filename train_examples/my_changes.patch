+                reagents_pred, solvents_pred = pred_dict.get("reagents"), pred_dict.get("solvents")
+                #solvents_pred = pred_json.split("solvents:")[-1].split("reagents:")[0].strip()
+                #else:
+                #    solvents_pred = None
+                print(f"Current predict condition for gold is {reagents_gold}, {solvents_gold} and for pred is {reagents_pred}, {solvents_pred}")
+                try:
+                    reagents_pred = Chem.MolToSmiles(Chem.MolFromSmiles(reagents_pred))
+                    #solvents_pred = Chem.MolToSmiles(Chem.MolFromSmiles(solvents_pred))
