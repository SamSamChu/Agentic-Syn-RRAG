+                nums["Reagents"] = nums["Reagents"] + 1
+            if solvents_gold is not None:
+                nums["Solvents"] = nums["Solvents"] + 1
+            if solvents_gold is not None and reagents_gold is not None:
+                nums[type_t] = nums[type_t] + 1
+            '''
+            if "reagents:" in gold:
+                reagents_gold = gold.split("reagents:")[-1].strip()
+            else:
+                reagents_gold = None
+            '''#print(f"DEBUG reagents are {reagents_gold}")
+            #assert 0
+            '''if "solvents" in gold and "reagents" not in gold:
+                solvents_gold = gold.split("solvents:")[-1].strip()
+            elif "solvents" in gold and "reagents" in gold:
