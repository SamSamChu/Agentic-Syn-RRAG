+                reagents_gold = gold.split("solvents:")[0].split("reagents:")[-1].strip()
+            else:
+                solvents_gold = None
+            '''
+            for pred_json in preds:
+                print(f"Current pred_json is {pred_json} and {gold}")
+                #reagents_pred = pred_json.split("reagents:")[-1].strip()
+                #solvents_pred = pred_json.split("solvents:")[-1].split("reagents:")[0].strip()
+                #if "solvents" in pred_json and "reagents" not in pred_json:
+                #    solvents_pred = pred_json.split("solvents:")[-1].strip()
+                #elif "solvents" in pred_json and "reagents" in pred_json:
+                #solvents_pred = pred_json.split("solvents:")[-1].strip()
+                #reagents_pred = pred_json.split("solvents:")[0].split("reagents:")[-1].strip()
